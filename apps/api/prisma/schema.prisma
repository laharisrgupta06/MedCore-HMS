// MedCore HMS Prisma schema.
// Phase 0 contains only the generator and datasource. Models are designed and
// owned by the Database Engineer starting in Phase 1 (see docs/implementation-roadmap.md, section 5).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
