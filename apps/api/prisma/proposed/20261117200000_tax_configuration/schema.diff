+// Phase 8: tax configuration (M-11a, DEC-045 to DEC-050) ------------------------------------------
+// Rules Prisma cannot express (CHECKs, the exclusion constraint, immutability triggers) live in the
+// migration: prisma/migrations/20261117200000_tax_configuration.
+
+/// The stable identity of a kind of supply in one hospital. Never deleted; only the name and the
+/// active flag change.
+model TaxClassification {
+  id          String        @id @default(uuid()) @db.Uuid
+  hospitalId  String        @db.Uuid
+  name        String
+  supplyType  TaxSupplyType
+  hsnSac      String        @db.VarChar(8)
+  isActive    Boolean       @default(true)
+  createdById String        @db.Uuid
+  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
+  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)
+
+  hospital  Hospital                   @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
+  createdBy User                       @relation("TaxClassificationCreatedBy", fields: [createdById, hospitalId], references: [id, hospitalId], onDelete: Restrict)
+  versions  TaxClassificationVersion[]
+  defaults  HospitalTaxDefault[]
+  labTests  LabTest[]
+  medicines Medicine[]
+
+  @@unique([id, hospitalId])
+  @@unique([hospitalId, name])
+  @@map("tax_classifications")
+}
+
+/// What the law says for a classification from a date. The version in force on a date has the
+/// latest effectiveFrom on or before it. Immutable once it has taken effect.
+model TaxClassificationVersion {
+  id               String       @id @default(uuid()) @db.Uuid
+  hospitalId       String       @db.Uuid
+  classificationId String       @db.Uuid
+  treatment        TaxTreatment
+  ratePercent      Decimal      @db.Decimal(5, 2)
+  priceIncludesTax Boolean
+  effectiveFrom    DateTime     @db.Date
+  createdById      String       @db.Uuid
+  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
+
+  hospital       Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
+  classification TaxClassification @relation(fields: [classificationId, hospitalId], references: [id, hospitalId], onDelete: Restrict)
+  createdBy      User              @relation("TaxClassificationVersionCreatedBy", fields: [createdById, hospitalId], references: [id, hospitalId], onDelete: Restrict)
+
+  @@unique([id, hospitalId])
+  @@unique([classificationId, effectiveFrom])
+  @@map("tax_classification_versions")
+}
+
+/// The hospital's classification for consultations and for lab tests (kind CONSULTATION or LAB).
+model HospitalTaxDefault {
+  hospitalId       String          @db.Uuid
+  kind             InvoiceItemKind
+  classificationId String          @db.Uuid
+  updatedById      String          @db.Uuid
+  updatedAt        DateTime        @updatedAt @db.Timestamptz(3)
+
+  hospital       Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
+  classification TaxClassification @relation(fields: [classificationId, hospitalId], references: [id, hospitalId], onDelete: Restrict)
+  updatedBy      User              @relation("HospitalTaxDefaultUpdatedBy", fields: [updatedById, hospitalId], references: [id, hospitalId], onDelete: Restrict)
+
+  @@id([hospitalId, kind])
+  @@map("hospital_tax_defaults")
+}
+
+/// Dated GST registrations; the one in force on a date has the latest effectiveFrom on or before
+/// it. Never edited or backdated. A GSTIN belongs to one MedCore hospital only (Q1g A).
+model HospitalGstRegistration {
+  id               String              @id @default(uuid()) @db.Uuid
+  hospitalId       String              @db.Uuid
+  registrationType GstRegistrationType
+  gstin            String?             @db.VarChar(15)
+  legalName        String?
+  stateCode        String?             @db.Char(2)
+  effectiveFrom    DateTime            @db.Date
+  attestedById     String              @db.Uuid
+  attestedAt       DateTime            @default(now()) @db.Timestamptz(3)
+
+  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
+  attestedBy User     @relation("GstRegistrationAttestedBy", fields: [attestedById, hospitalId], references: [id, hospitalId], onDelete: Restrict)
+
+  @@unique([id, hospitalId])
+  @@unique([hospitalId, effectiveFrom])
+  @@map("hospital_gst_registrations")
+}
+
+/// Platform reference data (not tenant data): the statutory room rule. Append-only; changed only by
+/// a reviewed migration.
+model StatutoryRoomTaxRule {
+  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
+  effectiveFrom    DateTime @unique @db.Date
+  thresholdPerDay  Decimal  @db.Decimal(12, 2)
+  ratePercent      Decimal  @db.Decimal(5, 2)
+  sacCode          String   @db.VarChar(8)
+  priceIncludesTax Boolean  @default(false)
+  legalReference   String
+  createdAt        DateTime @default(now()) @db.Timestamptz(3)
+
+  @@map("statutory_room_tax_rules")
+}
