+/// Document number series (DEC-052): per hospital, registration, financial year and document type;
+/// the scope is the GSTIN, or the hospital when unregistered. Never deleted; the counter never
+/// decreases; opened automatically at the first finalise of a year, or by the hospital admin.
+model DocumentNumberSeries {
+  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
+  hospitalId        String                   @db.Uuid
+  gstRegistrationId String?                  @db.Uuid
+  numberingScope    String
+  documentType      DocumentType
+  financialYear     String                   @db.VarChar(5)
+  prefix            String                   @db.VarChar(4)
+  nextSerial        Int                      @default(1)
+  openedAt          DateTime                 @default(now()) @db.Timestamptz(3)
+  openedById        String                   @db.Uuid
+  closedAt          DateTime?                @db.Timestamptz(3)
+  closedById        String?                  @db.Uuid
+
+  hospital        Hospital                 @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
+  gstRegistration HospitalGstRegistration? @relation(fields: [gstRegistrationId, hospitalId], references: [id, hospitalId], onDelete: Restrict)
+  openedBy        User                     @relation("DocumentSeriesOpenedBy", fields: [openedById, hospitalId], references: [id, hospitalId], onDelete: Restrict)
+  closedBy        User?                    @relation("DocumentSeriesClosedBy", fields: [closedById, hospitalId], references: [id, hospitalId], onDelete: Restrict)
+  invoices        Invoice[]
+
+  @@unique([id, hospitalId])
+  @@unique([numberingScope, financialYear, prefix])
+  @@unique([hospitalId, financialYear, prefix])
+  @@map("document_number_series")
+}
