{
  "name": "@medcore/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:int": "jest --config test/jest-int.config.js --runInBand",
    "test:cov": "jest --coverage",
    "prisma:generate": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js generate",
    "prisma:validate": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js validate",
    "prisma:migrate:create": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js migrate dev --create-only",
    "prisma:migrate": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js migrate dev",
    "prisma:deploy": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js migrate deploy",
    "create-super-admin": "nest build && node --env-file-if-exists=../../.env dist/cli/create-super-admin.js",
    "prisma:preview-sql": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script",
    "prisma:drift": "node --env-file-if-exists=../../.env scripts/prisma-drift.mjs",
    "icd10:load": "nest build && node --env-file-if-exists=../../.env dist/cli/load-icd10.js"
  },
  "dependencies": {
    "@medcore/types": "workspace:*",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.10",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.10",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.10",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "6.19.3",
    "@sentry/node": "^11.12.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.7.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.5.0",
    "pdfkit": "^0.17.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@medcore/config": "workspace:*",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.2.10",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/ioredis-mock": "^8.2.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/supertest": "^6.0.3",
    "ioredis-mock": "^8.13.1",
    "jest": "^30.5.2",
    "prisma": "6.19.3",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "typescript": "~5.9.3"
  }
}
