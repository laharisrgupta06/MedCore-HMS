# MedCore HMS environment variables.
# Copy to .env (git-ignored) and replace every placeholder. Never commit .env.
# Generate secrets with: openssl rand -hex 32

# --- Local infrastructure (docker/compose.dev.yml) ---
POSTGRES_USER=medcore
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_DB=medcore

# --- API (apps/api). Validated at startup by apps/api/src/config/env.ts ---
NODE_ENV=development
API_PORT=3001
# Must use the same user, password and database as above.
DATABASE_URL=postgresql://medcore:replace-with-a-local-database-password@localhost:5432/medcore?schema=public
REDIS_URL=redis://localhost:6379
# At least 32 characters each, and different from each other.
JWT_ACCESS_SECRET=replace-with-output-of-openssl-rand-hex-32
JWT_REFRESH_SECRET=replace-with-a-different-output-of-openssl-rand-hex-32
# Encrypts clinical text in the database (pgcrypto). Keep it safe: values cannot be read without it.
EMR_ENCRYPTION_KEY=replace-with-a-third-output-of-openssl-rand-hex-32
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000
# Optional. Leave empty to disable Sentry.
SENTRY_DSN=
# General API rate limit (PRD: 1000 requests per minute).
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=1000
# Auth endpoint limit (PRD: 100 requests per 15 minutes per IP).
AUTH_THROTTLE_TTL_MS=900000
AUTH_THROTTLE_LIMIT=100
# Public URL of the web app (used in password-reset links).
WEB_APP_URL=http://localhost:3000

# --- Email (DEC-011). Development: Mailpit, inbox at http://localhost:8025 ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MedCore HMS <no-reply@medcore.local>

# --- SMS (DEC-011). dev-inbox = local only (GET /api/dev/sms-inbox); refused in production ---
SMS_PROVIDER=dev-inbox

# Timed background jobs (nightly expiry run at 02:00 hospital time). on/off; unset = on, except
# NODE_ENV=test. Integration tests always switch them off and run the job only for test hospitals.
# SCHEDULED_JOBS=on
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Web (apps/web). Server-only; never prefix secrets with NEXT_PUBLIC_ ---
# Where the Next.js same-origin proxy forwards /api/*. Defaults to http://localhost:3001.
API_INTERNAL_URL=http://localhost:3001

# End-to-end tests (DEC-061). The shared sign-in password for the seeded test accounts in the
# disposable medcore_e2e database. Choose a new password used nowhere else: 10 to 128 characters
# with at least one letter and one number. Never commit it. Checked by `pnpm e2e:check`.
E2E_PASSWORD=

# Evaluator demo hospital (apps/api/src/cli/seed-demo.ts). The shared sign-in password for the demo
# accounts at @demo.medcore.example. Choose one used nowhere else (not E2E_PASSWORD): 10 to 128
# characters with at least one letter and one number. Never commit it. Run the seed with
#   DEMO_CONFIRM_DB=<database name> pnpm --filter @medcore/api seed:demo
DEMO_PASSWORD=

# ---- Online payments (DEC-054) ----
# fake = development test checkout (default outside production); none = cash only (default in production).
# stripe and razorpay are not implemented yet and are answered as "not configured".
# PAYMENT_PROVIDER=fake
# FAKE_PAYMENT_WEBHOOK_SECRET=<at least 32 random characters; optional in development>
# Stripe (PAYMENT_PROVIDER=stripe): test-mode keys from the Stripe dashboard
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Razorpay (PAYMENT_PROVIDER=razorpay): test-mode keys from the Razorpay dashboard
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
